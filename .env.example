# Leave empty for the explicit «Демо без AI» mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_PROVIDER=openai-compatible
# json_schema for strict structured output, json_object for compatible providers.
# Both formats are validated by the application. Test the chosen format in the UI.
AI_RESPONSE_FORMAT=json_schema
AI_TOTAL_TIMEOUT_SECONDS=60
# Optional custom SQLite file; relative paths are resolved from the project.
SUPPORTLENS_DB=data/supportlens.sqlite3
